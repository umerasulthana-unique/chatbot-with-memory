# Copy this file to .env and fill in your real key
# Get a free Gemini API key (no card required) at https://aistudio.google.com
GEMINI_API_KEY=your_api_key_here

# Server port
PORT=3000

# Sliding window: max number of messages (user+assistant combined)
# kept in the context sent to the LLM. Oldest messages are dropped first (FIFO).
MAX_HISTORY_MESSAGES=20

# Model to use — gemini-2.5-flash is free-tier eligible
MODEL_NAME=gemini-2.5-flash
